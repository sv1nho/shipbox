# Copy to .env and fill in. .env is gitignored.

# Database container. Host port is 5433 to avoid clashing with a native Postgres.
POSTGRES_USER=ship_box
POSTGRES_PASSWORD=password
POSTGRES_DB=ship_box
POSTGRES_PORT=5433

DATABASE_URL="postgresql://ship_box:PASSWORD@127.0.0.1:5433/ship_box?schema=public"

# API server. Keep 127.0.0.1 locally; a hosting platform will require 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=3000
NODE_ENV=development

# Public origin of the frontend. Used by Better Auth trusted origins and CORS.
WEB_ORIGIN="http://localhost:5173"

# Public base URL the auth endpoints are reached at. In development the Vite
# proxy means that is the frontend port, not the API port. It must match the
# redirect URI registered with the OAuth provider, character for character.
BETTER_AUTH_URL="http://localhost:5173"

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud console, see README. Optional in development, required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
