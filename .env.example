# Copy to .env and fill in. .env is gitignored.

# Database container. Host port is 5433 to avoid clashing with a native Postgres.
POSTGRES_USER=ship_box
POSTGRES_PASSWORD=
POSTGRES_DB=ship_box
POSTGRES_PORT=5433

DATABASE_URL="postgresql://ship_box:PASSWORD@127.0.0.1:5433/ship_box?schema=public"

# API server. Keep 127.0.0.1 locally; a hosting platform will require 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=3000
NODE_ENV=development

# Opens an email and password sign-in, for the browser tests only. The API
# refuses to start with this on in production.
E2E_AUTH=false

# How many requests one caller may send to /api per minute.
RATE_LIMIT_PER_MINUTE=120

# How many proxies sit in front of the API. 0 locally. A hosting platform that
# terminates TLS for you usually means 1. Set it, or the rate limit counts every
# visitor as the same one.
TRUSTED_PROXY_HOPS=0

# Public origin of the frontend. Used by Better Auth trusted origins and CORS.
WEB_ORIGIN="http://localhost:5173"

# Public base URL the auth endpoints are reached at. In development the Vite
# proxy means that is the frontend port, not the API port. It must match the
# redirect URI registered with the OAuth provider, character for character.
BETTER_AUTH_URL="http://localhost:5173"

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# OAuth providers, see README. Set both halves of a pair or neither.
# At least one provider is required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
