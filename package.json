{
  "name": "bpost-label-generator",
  "version": "1.0.0",
  "description": "Shipping label generator with PDF and barcode",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "node -e \"const fs=require('fs'); const path=require('path'); fs.cpSync(path.join(__dirname,'src/assets'), path.join(__dirname,'dist/assets'), {recursive:true, force:true})\"",
    "start": "npm run build && electron .",
    "test": "npm run build && concurrently \"tsc -p tsconfig.json --watch\" \"npm run watch-electron\"",
    "watch-electron": "nodemon --watch dist --ext js --exec \"cross-env NODE_ENV=test electron .\" --delay 500ms",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "clear": "rimraf node_modules dist package-lock.json"
  },
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "10.3.0",
    "bwip-js": "4.3.0",
    "puppeteer": "24.15.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "concurrently": "8.2.2",
    "cross-env": "10.1.0",
    "electron": "41.0.2",
    "eslint": "9.0.0",
    "nodemon": "3.0.2",
    "rimraf": "6.1.3",
    "typescript": "5.7.2"
  }
}
