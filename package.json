{
  "name": "ship_box",
  "version": "1.0.0",
  "description": "ShipBox — return label generator and shipment tracker for bpost and PostNL",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sv1nho/shipbox.git"
  },
  "bugs": {
    "url": "https://github.com/sv1nho/shipbox/issues"
  },
  "homepage": "https://github.com/sv1nho/shipbox#readme",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "test": "vitest run --coverage --project client --project server --project db",
    "fuzz": "vitest run --project fuzz",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "knip": "knip --no-progress",
    "size": "tsx scripts/check-bundle.ts",
    "e2e": "playwright test",
    "e2e:db": "tsx e2e/prepare-database.ts",
    "e2e:shots": "playwright test screens",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "typecheck:api": "tsc -p tsconfig.server.json --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && npm run db:generate",
    "db:deploy": "prisma migrate deploy && npm run db:generate",
    "db:reset": "prisma migrate reset && npm run db:generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "clear": "rimraf node_modules dist coverage server/generated package-lock.json",
    "postinstall": "npm run db:generate",
    "e2e:hostile": "playwright test hostile-input",
    "measure": "tsx scripts/measure-list.ts",
    "measure:api": "tsx scripts/measure-api.ts"
  },
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@faker-js/faker": "10.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/vite": "4.3.0",
    "better-auth": "1.7.3",
    "compression": "^1.8.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsbarcode": "3.12.3",
    "jspdf": "4.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.78.0",
    "react-router": "8.3.0",
    "svg2pdf.js": "2.7.0",
    "swagger-ui-express": "5.0.1",
    "tailwindcss": "4.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-react/eslint-plugin": "5.18.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "fast-check": "^4.10.2",
    "happy-dom": "20.10.2",
    "knip": "6.39.0",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  }
}
